From: Oskari Alaranta <oskari.alaranta@bananymous.com>
Date: Sun, 16 Aug 2026 22:14:02 +0300
Subject: [PATCH] dont require j1

---
 src/filters.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/filters.c b/src/filters.c
index 0cbc5731..d3881b14 100644
--- a/src/filters.c
+++ b/src/filters.c
@@ -444,6 +444,7 @@ static double jinc(const struct pl_filter_ctx *f, double x)
     if (x < 1e-8)
         return 1.0;
     x *= M_PI;
+    __builtin_trap();
     return 2.0 * j1(x) / x;
 }
 
